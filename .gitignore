# -------------------
# Gradle Build Files
# -------------------
.gradle/
build/
# Ignore Gradle GUI config
gradle-app.setting
# Avoid ignoring the wrapper jar, but ignore local properties
!gradle-wrapper.jar
.gradletasknamecache

